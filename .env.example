# OpenAI
OPENAI_API_KEY=sk-...
# Cheapest current OpenAI text model (override only if needed)
OPENAI_MODEL=gpt-5-nano

# X session cookies from a logged-in browser (DevTools → Application → Cookies → x.com)
# auth_token and ct0 are required. Do NOT use username/password on Vercel.
X_AUTH_TOKEN=
X_CT0=

# Protect cron + manual engage endpoints
CRON_SECRET=change-me-to-a-long-random-string

# Safety defaults — keep DRY_RUN=true until you verify behavior
DRY_RUN=true
MAX_CANDIDATES=8
MAX_LIKES=3
MAX_REPLIES=2
MIN_DELAY_MS=2500
MAX_DELAY_MS=6000
SCROLL_ROUNDS=3
